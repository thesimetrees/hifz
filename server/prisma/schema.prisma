// Prisma schema Ihya — CMS super admin (SQLite, siap dipindah ke PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// peran: admin | tutor | customer | pelamar
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nama      String
  peran     String   @default("customer")
  aktif     Boolean  @default(true)
  telepon   String?
  alamat    String?
  bio       String?
  foto      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// status: draf | terbit — kurikulum: JSON tema -> sub-tema -> materi
model Program {
  id        String   @id @default(cuid())
  nama      String
  kategori  String
  jenis     String
  mode      String   @default("Online")
  tutor     String
  harga     Int      @default(0)
  deskripsi String
  gambar    String?
  status    String   @default("draf")
  peserta   Int      @default(0)
  kurikulum String   @default("[]")
  jadwal    String   @default("null")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("programs")
}

model Product {
  id         String   @id @default(cuid())
  nama       String
  kategori   String   @default("Umum")
  harga      Int
  hargaCoret Int      @default(0)
  stok       Int      @default(0)
  terjual    Int      @default(0)
  gambar     String?
  ringkas    String?
  deskripsi  String?
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("products")
}

// status: Menunggu | Lunas | Dibatalkan — jenis: toko | program
model Order {
  invoice   String   @id
  item      String
  metode    String
  total     Int
  status    String   @default("Menunggu")
  jenis     String   @default("toko")
  penerima  String
  alamat    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// status: draf | terbit
model Post {
  id        String   @id @default(cuid())
  judul     String
  kategori  String   @default("Artikel")
  gambar    String?
  ringkas   String?
  penulis   String   @default("Tim Ihya")
  konten    String?
  status    String   @default("draf")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}
